id: neara.sce
version: 1.0.0
node_types:
  - model_delta
  - clearance_policy
  - customer_value
  - operational_priority
nodes:
  - id: neara.model_delta
    type: model_delta
    label: Neara model delta
    properties:
      description: Clearance model output after policy expansion.
    source_refs:
      - demo_model_output_after
    version: 1.0.0
  - id: sce.clearance_policy
    type: clearance_policy
    label: Clearance policy
    properties:
      delta: 3m_to_5m
      watch_distance_m: 5
    source_refs:
      - sce-vegetation-management.source
    version: 1.0.0
  - id: sce.customer_value
    type: customer_value
    label: SCE customer value
    properties:
      value: expanded operational planning and budget exposure
    source_refs: []
    version: 1.0.0
  - id: sce.operational_priority
    type: operational_priority
    label: Operational priority
    properties:
      priority: validate_expanded_watch_items
    source_refs: []
    version: 1.0.0

